{
  "name": "aguja-companion",
  "productName": "LA AGUJA Flash Imager",
  "version": "0.9.4",
  "private": true,
  "author": {
    "name": "Transcendence IA",
    "email": "soporte@transcendenceia.net"
  },
  "description": "Prepara y graba tu disco de rescate La Aguja desde Windows y Linux",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "node tests/electron-e2e.cjs",
    "build:linux": "electron-builder --linux dir deb AppImage && node tests/package-portable.cjs",
    "build:appimage": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win dir portable",
    "test:e2e:image": "node tests/image-e2e.cjs"
  },
  "devDependencies": {
    "electron": "40.10.6",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "net.transcendenceia.aguja.companion",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "core.cjs",
      "bitlocker.cjs",
      "fat32-writer.cjs",
      "flash-windows.ps1",
      "windows-flash.cjs",
      "ui/**/*",
      "resources/**/*",
      "package.json",
      "README.md",
      "ai-tools.cjs",
      "provisioning.cjs",
      "linux-privileged.cjs",
      "windows-environment.cjs",
      "windows-privileged.cjs",
      "public-download.cjs",
      "windows-native-import.cjs",
      "windows-credentials.ps1"
    ],
    "extraResources": [
      {
        "from": "../scripts",
        "to": "aguja/scripts",
        "filter": [
          "platform-profile.py",
          "flash-usb.py"
        ]
      },
      {
        "from": "../runtime",
        "to": "aguja/runtime",
        "filter": [
          "profile.py",
          "config.py",
          "locale-catalog.json",
          "i18n.py"
        ]
      },
      {
        "from": "wifi-helper.py",
        "to": "aguja/wifi-helper.py"
      },
      {
        "from": "flash-windows.ps1",
        "to": "aguja/flash-windows.ps1"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "icon": "ui/assets/icon.png",
      "artifactName": "aguja-flash-imager-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "category": "Utility",
      "icon": "ui/assets/icon.png",
      "target": [
        "dir",
        "tar.gz",
        "deb"
      ],
      "syncDesktopName": true,
      "artifactName": "aguja-flash-imager-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": [
        "python3",
        "python3-cryptography",
        "mtools",
        "openssl",
        "pkexec",
        "zstd",
        "gdisk",
        "e2fsprogs",
        "util-linux",
        "libgtk-3-0t64 | libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ],
      "fpm": [
        "--deb-suggests",
        "network-manager"
      ],
      "recommends": [
        "libayatana-appindicator3-1 | libappindicator3-1"
      ]
    },
    "compression": "store"
  },
  "homepage": "https://aguja.transcendenceia.net",
  "desktopName": "aguja-companion.desktop",
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "age-encryption": "0.3.1",
    "jsonc-parser": "3.3.1"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Transcendenceia/La-Aguja.git"
  }
}
