{
  "schema_version": 3,
  "module": "aguja-iot",
  "description": "ESP32-family development board registry, hardware fingerprint matcher, and prebuilt firmware manifest for LA AGUJA Flash Imager.",
  "nvs_provisioning": {
    "partition_name": "nvs",
    "offset": "0x9000",
    "size_bytes": 49152,
    "namespace": "aguja_cfg",
    "init_json_key": "init_json",
    "blob_key": "blob_v1",
    "struct_version": 1,
    "max_wifi_profiles": 8,
    "softap_default_enabled": false,
    "fields": [
      "wifi.profiles[] (up to 8 prioritized SSID/password pairs)",
      "ap (enabled=false default, ssid, pass, channel, max_conn)",
      "tailnet (hostname, ctrl_host, ctrl_noise_pubkey_hex, auth_key, derp_region, exit_node_enabled, advertise_upstream_subnet, advertise_ap_subnet, extra_routes, dns_relay_enabled, dns_upstream)",
      "hw (antenna_external, led_mode, cpu_mhz, boot_gpios[])",
      "agent (api_token, http_allow_lan, beacon_enabled, beacon_ip, beacon_port, beacon_interval_s)"
    ]
  },
