# Common defaults for LA AGUJA IoT firmware (target overrides in sdkconfig.defaults.<target>)

# Flash & Partition Table (4 MB-compatible Dual-OTA + Rollback; works on 4/8/16 MB boards)
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Compiler & Size Optimization (fit comfortably in 1920K OTA slot + save SRAM)
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096

# Power Management (dynamic CPU frequency scaling via API)
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n

# FreeRTOS stats for live task/heap telemetry
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# WiFi: STA + SoftAP NAT Gateway + lean buffers for 512KB SRAM
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# lwIP: IP Forwarding + NAPT (Subnet Router + Exit Node + SoftAP NAT)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_NETIF_LOOPBACK=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_FORWARD=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_INPUT_DEFAULT=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12

# HTTP Server (Aguja-IoT Agent Ops API + Web UI)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_DELAY=y

# mbedTLS: Let's Encrypt CA bundle + lean memory
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# MicroLink Tailscale/Headscale VPN Configuration (generic public defaults;
# override for self-hosted Headscale via sdkconfig.secrets, NVS, or Flash Imager IoT)
CONFIG_ML_CTRL_HOST="controlplane.tailscale.com"
CONFIG_ML_CTRL_TLS=y
CONFIG_ML_CTRL_TLS_VERIFY_CERT=y
CONFIG_ML_CTRL_STREAMING_MAP_FETCH=y
CONFIG_ML_CTRL_NOISE_PUBKEY_HEX=""
CONFIG_ML_DERP_REGION=9
CONFIG_ML_DERP_VERIFY_CERT=y
CONFIG_ML_MAX_PEERS=16
CONFIG_ML_NVS_MAX_PEERS=32
CONFIG_ML_H2_BUFFER_SIZE_KB=64
CONFIG_ML_JSON_BUFFER_SIZE_KB=80
CONFIG_ML_PRIORITY_PEER_IP=""
CONFIG_ML_SUBNET_ROUTER=y
CONFIG_ML_ROUTER_IPV6=y
CONFIG_ML_ADVERTISE_ROUTES="0.0.0.0/0,192.168.4.0/24"
CONFIG_ML_OTA_ROLLBACK=y
CONFIG_ML_OTA_CONFIRM_TIMEOUT_S=180
CONFIG_ML_ENABLE_CONFIG_HTTPD=n
CONFIG_ML_ENABLE_CELLULAR=n
CONFIG_ML_PACKET_FILTER_OFF=y

# Logging: INFO default, dynamic per-tag control + ring buffer capture
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_COLORS=n
