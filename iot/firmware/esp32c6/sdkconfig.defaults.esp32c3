# Target overrides: ESP32-C3 (SuperMini, XIAO ESP32-C3, DevKitM-1 · 4 MB Flash, 400 KB SRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=10
CONFIG_ML_MAX_PEERS=12
CONFIG_ML_H2_BUFFER_SIZE_KB=48
CONFIG_ML_JSON_BUFFER_SIZE_KB=64
