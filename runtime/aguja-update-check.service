[Unit]
Description=LA AGUJA optional public update inventory (never installs)
After=aguja-boot.service NetworkManager.service
ConditionPathIsMountPoint=/data
ConditionPathIsMountPoint=/config

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/aguja/update_jobs.py check
Nice=10
CPUQuota=50%
MemoryMax=512M
TimeoutStartSec=300
